{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "websearch": true,
    "webfetch": true
  },
  "permission": {
    "read": {
      ".env": "allow",
      ".env.*": "allow",
      ".env-*": "allow"
    },
    "external_directory": "allow",
    "bash": {
      "git push": "allow",
      "git push *": "allow",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      ":(){:|:&};:": "deny"
    }
  },
  "agent": {
    "explore": {
      "description": "Fast read-only codebase exploration using eza, fd, and rg",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "temperature": 0.1,
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": false,
        "write": false,
        "edit": false,
        "task": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow"
        }
      }
    }
  }
}
